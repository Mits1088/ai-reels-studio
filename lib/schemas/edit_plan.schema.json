{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edit-plan.json",
  "description": "Editorial intermediate layer between approved beat-map and timeline.json. Each beat carries an explicit template, asset selection (with candidates, confidence, fallback chain, and review flag), motion budget, caption mode, and rationale. The Phase C compiler (lib/edit_plan/compile.py) is the only consumer that turns this into a renderable timeline.json. Phase C adds optional render-config fields (audio/avatar_file/project) and an optional verbatim_lanes block so the compiler can round-trip legacy timelines whose shape does not fit a clean per-beat model.",
  "type": "object",
  "required": ["schema_version", "project_slug", "beats"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Edit-plan schema version. Bumped when this file's structure changes."
    },
    "project_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Matches projects/<slug>/ — used for cross-checks against project.json"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 timestamp when the plan was generated or last validated"
    },
    "compiler_version": {
      "type": "string",
      "description": "Pinned compiler version that produced or last validated this plan."
    },
    "style": {
      "type": "string",
      "enum": ["cinematic-presenter", "editorial-authority", "proof-escalation-editorial"],
      "description": "Style profile from project.json. Drives template defaults and critic thresholds."
    },
    "audio": {
      "type": "string",
      "description": "Optional override for the audio file name (default 'source.wav')."
    },
    "avatar_file": {
      "type": "string",
      "description": "Optional override for the avatar file name (default 'avatar.mp4')."
    },
    "project": {
      "type": "string",
      "description": "Optional project label written to the top of timeline.json (legacy top-level field used by some reels)."
    },
    "total_duration": {
      "type": "number",
      "minimum": 0,
      "description": "Optional override. When absent, the compiler reads it from beat-map.total_duration."
    },
    "meta": {
      "type": "object",
      "description": "Free-form annotations (notes, source, brief reference, hook hypothesis, etc.)",
      "additionalProperties": true
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/beat_plan" }
    },
    "verbatim_lanes": {
      "type": "object",
      "description": "Optional verbatim per-lane data. When set, the compiler uses these lanes directly instead of generating from beats. Used by reverse-engineering to preserve legacy timeline shape exactly. Lanes that are absent fall back to the generator.",
      "additionalProperties": false,
      "properties": {
        "avatar":   { "type": "array", "items": { "type": "object" } },
        "demo":     { "type": "array", "items": { "type": "object" } },
        "broll":    { "type": "array", "items": { "type": "object" } },
        "support":  { "type": "array", "items": { "type": "object" } },
        "captions": { "type": "array", "items": { "type": "object" } },
        "sfx":      { "type": "array", "items": { "type": "object" } },
        "music":    { "type": "array", "items": { "type": "object" } },
        "overlays": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "$defs": {
    "beat_plan": {
      "type": "object",
      "description": "One beat's editorial decisions. Mirrors a beat in audio/beat-map.json by beat_id.",
      "required": [
        "beat_id",
        "template_id",
        "avatar_mode",
        "caption_mode",
        "split_ratio",
        "candidate_assets",
        "selected_asset_id",
        "selection_confidence",
        "selection_reason",
        "fallback_asset_ids",
        "human_review_required",
        "motion_budget",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "type": "string",
          "pattern": "^beat-\\d{2,}[a-z]?$"
        },
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "proof_class": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": [
                "existence",
                "breadth",
                "process",
                "output",
                "integration",
                "authority",
                "cta"
              ]
            }
          ]
        },
        "avatar_mode": {
          "type": "string",
          "minLength": 1
        },
        "caption_mode": {
          "type": "string",
          "enum": [
            "standard",
            "headline",
            "suppressed",
            "section-label",
            "badge-overlay"
          ]
        },
        "split_ratio": {
          "type": "string",
          "pattern": "^\\d{1,3}/\\d{1,3}$"
        },
        "proof_protected": {
          "type": "boolean"
        },
        "candidate_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset_id", "score", "reason"],
            "additionalProperties": false,
            "properties": {
              "asset_id":  { "type": "string", "minLength": 1 },
              "score":     { "type": "number", "minimum": 0, "maximum": 1 },
              "reason":    { "type": "string", "minLength": 1 }
            }
          }
        },
        "selected_asset_id": {
          "type": ["string", "null"]
        },
        "selected_asset_filename": {
          "type": ["string", "null"],
          "description": "Optional filename hint. When set, the compiler uses this directly without consulting the catalog (catalog-free compile)."
        },
        "selection_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "selection_reason": {
          "type": "string"
        },
        "fallback_asset_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "human_review_required": {
          "type": "boolean"
        },
        "motion_budget": { "$ref": "#/$defs/motion_budget" },
        "zoom_moments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "x", "y", "scale"],
            "additionalProperties": false,
            "properties": {
              "at":      { "type": "number", "minimum": 0 },
              "x":       { "type": "number", "minimum": 0, "maximum": 100 },
              "y":       { "type": "number", "minimum": 0, "maximum": 100 },
              "scale":   { "type": "number", "minimum": 1.0, "maximum": 3.0 },
              "holdFor": { "type": "number", "minimum": 0 }
            }
          }
        },
        "playback_rate": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4.0
        },
        "render_overrides": {
          "type": "object",
          "description": "Free-form key/value overrides applied verbatim onto the compiled content lane entry (e.g. transition_preset, display, clipStartTime, custom notes). Used by reverse-engineering to capture render-only fields the editorial schema does not model.",
          "additionalProperties": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "motion_budget": {
      "type": "object",
      "required": ["hero"],
      "additionalProperties": false,
      "properties": {
        "hero":    { "$ref": "#/$defs/motion_event" },
        "support": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/motion_event" }
          ]
        },
        "accent": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/motion_event" }
          ]
        }
      }
    },
    "motion_event": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind":            { "type": "string", "minLength": 1 },
        "preset":          { "type": ["string", "null"] },
        "duration_frames": { "type": ["integer", "null"], "minimum": 1, "maximum": 15 }
      }
    }
  }
}
