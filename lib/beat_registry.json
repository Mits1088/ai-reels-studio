        "default_transition": { "enter": "zoom-in", "exit": "fade", "enterDur": 6, "exitDur": 3 },
        "mandatory_extras": ["LogoOverlay with bounce:true, trail:true for energy"],
        "notes": "Hook-reveal: screenshot fades/reveals in top zone, avatar visible below from frame 0."
      },
      "emotional_keyword": {
        "primary": ["KeywordFadeIn"],
        "secondary": [],
