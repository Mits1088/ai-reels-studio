    }
  },

  "mandatory_brand_rule": "Whenever a brand is NAMED in the narration (regardless of beat classification), add a LogoOverlay entry in the overlays lane at that timestamp. This is non-negotiable — text-only brand references are a fitness audit failure.",

  "background_map": {
    "editorial-authority": {
      "hook_opening": "solid-brand or ScrollingIconGrid (no Aurora/Beams)",
      "direct_address": "solid dark #1A1A1A (no GradientMesh)",
      "number_proof_with_asset": "solid white #FFFFFF",
      "explanation_over_visual": "solid white #FFFFFF",
      "trust_credibility": "solid white #FFFFFF",
      "cta": "solid dark #1A1A1A",
      "section_transition": "white flash (FlashReset handles this)",
      "_default": "solid #FFFFFF"
    },
    "cinematic-presenter": {
      "hook_opening": "AuroraBackground (white)",
      "direct_address": "GradientMesh + SmokeWisp",
      "number_proof_with_asset": "AuroraBackground",
      "explanation_over_visual": "AuroraBackground",
      "trust_credibility": "AuroraBackground",
      "cta": "GradientMesh + SmokeWisp",
      "section_transition": "white flash",
      "_default": "AuroraBackground"
    }
  },

  "sfx_map": {
    "hook_opening": ["@sfx/whoosh on entry", "@sfx/ding per brand logo reveal"],
    "section_transition": ["@sfx/whip on flash"],
    "name_reveal": ["@sfx/ding or @sfx/uiSwitch"],
    "number_proof_with_asset": ["@sfx/mouseClick at zoom moment"],
    "list_item": ["@sfx/uiSwitch at NumberPopup entry"],
    "cta": ["@sfx/whoosh on entry"],
    "tool_intro_chapter": ["@sfx/pageTurn on chapter entry"]
  }
}
