{
  "_comment": "Beat-component registry. Deterministic lookup: style + beat_classification → component decision. Used by Phase 4b-ii (component mapping) to eliminate per-beat reasoning. Add new beat types here as they appear in reels — do NOT modify existing entries without updating all downstream shot-list examples.",
  "version": "1.0",

  "classifications": {
    "emotional_keyword": {
      "pattern": "Single word or short phrase that IS the emphasis",
      "examples": ["WRONG", "ZERO", "MORE", "GONE.", "FREE", "DANGEROUS"]
    },
    "staccato_claim": {
      "pattern": "2-5 word declarative with a period feel",
      "examples": ["No retraining.", "Works on any model.", "Zero accuracy loss."]
    },
    "name_reveal": {
      "pattern": "Introduces a product, feature, or concept name",
      "examples": ["called TurboQuant", "Jevons' Paradox", "LMArena.ai"]
    },
    "number_proof_with_asset": {
      "pattern": "Stat with visual evidence available",
      "examples": ["6x less memory + chart exists", "crashed 14% + stock chart"]
    },
    "number_proof_no_asset": {
      "pattern": "Stat with no visual evidence",
      "examples": ["saved 3 hours", "40% faster"]
    },
    "explanation_over_visual": {
      "pattern": "Describing what a visual shows",
      "examples": ["It compresses how AI stores data + diagram"]
    },
    "direct_address": {
      "pattern": "Talking to viewer, no visual needed",
      "examples": ["Here's why.", "But here's what nobody expected"]
    },
    "trust_credibility": {
      "pattern": "Citing authority or source",
      "examples": ["peer-reviewed at ICLR 2026 + research page"]
    },
    "contradiction_negation": {
      "pattern": "Striking through or negating something",
      "examples": ["people don't use less", "you're doing it wrong"]
    },
    "list_item": {
      "pattern": "Numbered or bulleted item in a series",
      "examples": ["Number one: LMArena", "Number two: DesignArena"]
    },
    "comparison": {
      "pattern": "Side-by-side or A vs B",
      "examples": ["ChatGPT vs Gemini", "before and after"]
    },
    "cta": {
      "pattern": "Call to action",
      "examples": ["Follow for more", "Comment AI"]
    },
    "section_transition": {
      "pattern": "Gap between major sections",
      "examples": ["(silence or breath between sections)"]
    },
    "hook_opening": {
      "pattern": "First 2-5 seconds, must stop the scroll",
      "examples": ["If you're paying for AI tools"]
    },
    "reframe_montage": {
      "pattern": "Summary or multi-source validation",
      "examples": ["Cheaper AI means AI everywhere"]
    },
    "tool_intro_chapter": {
      "pattern": "New section introducing a tool by name + logo",
      "examples": ["First up: Pinokio", "Next: Claude Code"]
    }
  },

  "component_map": {

    "editorial-authority": {
      "hook_opening": {
        "primary": ["ScrollingIconGrid", "OverlayKeyword"],
        "secondary": [],
        "avatar_layout": "split-screen",
        "content_zone": "top 45%",
        "default_transition": { "enter": "scale-pop-overshoot", "exit": "fade", "enterDur": 5, "exitDur": 3 },
        "mandatory_extras": ["LogoOverlay if brand is named"],
        "notes": "ScrollingIconGrid fills top zone. OverlayKeyword sits on top of grid. Avatar split-screen at bottom."
      },
      "emotional_keyword": {
        "primary": ["OverlayKeyword"],
        "secondary": [],
        "avatar_layout": "full-screen",
        "content_zone": "center on face",
        "default_transition": { "enter": "scale-pop-overshoot", "exit": "fade", "enterDur": 4, "exitDur": 2 },
        "mandatory_extras": [],
        "notes": "Text goes ON the avatar. Position: center. autoSize: true recommended."
      },
      "staccato_claim": {
        "primary": ["OverlayKeyword"],
        "secondary": [],
        "avatar_layout": "full-screen",
        "content_zone": "center on face",
        "default_transition": { "enter": "hard-cut", "exit": "hard-cut", "enterDur": 0, "exitDur": 0 },
        "mandatory_extras": [],
        "notes": "Hard cut. Staccato rhythm = no transition animation. Let the words hit."
      },
      "name_reveal": {
        "primary": ["HeroTextCard"],
        "secondary": [],
        "avatar_layout": "hidden",
        "content_zone": "full frame",
        "default_transition": { "enter": "scale-pop-overshoot", "exit": "fade", "enterDur": 5, "exitDur": 3 },
        "mandatory_extras": ["LogoOverlay for the named brand/product"],
        "notes": "Avatar hidden. Full-frame card. ALWAYS add LogoOverlay for the named entity."
      },
      "number_proof_with_asset": {
        "primary": ["FramedImage", "OverlayKeyword"],
        "secondary": [],
        "avatar_layout": "split-screen",
        "content_zone": "top 40-45%",
        "default_transition": { "enter": "zoom-in", "exit": "fade", "enterDur": 5, "exitDur": 3, "kenBurns": true },
        "mandatory_extras": ["zoom_moments required — target the specific number in the chart"],
        "notes": "FramedImage shows the proof. OverlayKeyword echoes the number on the avatar below."
      },
      "number_proof_no_asset": {
        "primary": ["HeroTextCard"],
        "secondary": [],
        "avatar_layout": "hidden",
        "content_zone": "full frame",
        "default_transition": { "enter": "scale-pop-overshoot", "exit": "fade", "enterDur": 5, "exitDur": 3 },
        "mandatory_extras": [],
        "notes": "No proof visual → number as giant text card. Make the number the hero."
      },
      "explanation_over_visual": {
        "primary": ["FramedImage"],
        "secondary": [],
        "avatar_layout": "split-screen",
        "content_zone": "top 40-45%",
        "default_transition": { "enter": "zoom-in", "exit": "fade", "enterDur": 5, "exitDur": 3, "kenBurns": true },
        "mandatory_extras": ["zoom_moments required"],
        "notes": "Avatar talks while diagram sits in top zone. Ken Burns keeps it alive."
      },
      "direct_address": {
        "primary": ["AvatarVideo"],
        "secondary": [],
        "avatar_layout": "full-screen",
        "content_zone": "—",
        "default_transition": { "enter": "hard-cut", "exit": "hard-cut", "enterDur": 0, "exitDur": 0 },
        "mandatory_extras": [],
        "notes": "Pure talking-head. No overlay unless it's a setup for the next beat."
      },
      "trust_credibility": {
        "primary": ["FramedImage", "AnnotationCircle", "BadgePopup"],
        "secondary": [],
        "avatar_layout": "split-screen",
        "content_zone": "top 40-45%",
        "default_transition": { "enter": "zoom-in", "exit": "fade", "enterDur": 5, "exitDur": 3 },
        "mandatory_extras": ["zoom_moments targeting the credibility signal (author name, institution logo, citation)"],
        "notes": "AnnotationCircle circles the key trust signal. BadgePopup echoes the source name."
      },
      "contradiction_negation": {
        "primary": ["OverlayKeyword"],
        "secondary": [],
        "avatar_layout": "full-screen",
        "content_zone": "center on face",
        "default_transition": { "enter": "scale-pop-overshoot", "exit": "fade", "enterDur": 4, "exitDur": 2 },
        "mandatory_extras": [],
        "props_override": { "withStrikethrough": true },
        "notes": "withStrikethrough: true draws the red line through the word. Pair with FlashReset before this beat."
      },
      "list_item": {
        "primary": ["CardStack", "HeroTextCard"],
        "secondary": [],
        "avatar_layout": "hidden",
        "content_zone": "full frame",
        "default_transition": { "enter": "slide-stack", "exit": "fade", "enterDur": 8, "exitDur": 3 },
        "mandatory_extras": ["LogoOverlay for each named tool"],
        "notes": "CardStack for 3+ items. HeroTextCard sequence for 1-2 items. slide-stack transition for card feel."
      },
      "comparison": {
        "primary": ["ComparisonGrid"],
        "secondary": [],
        "avatar_layout": "hidden",
        "content_zone": "full frame",
        "default_transition": { "enter": "scale-pop", "exit": "fade", "enterDur": 5, "exitDur": 3 },
        "mandatory_extras": [],
        "notes": "Avatar hidden for comparison. Full-frame side-by-side."
      },
      "cta": {
        "primary": ["AvatarVideo", "OverlayKeyword"],
        "secondary": [],
        "avatar_layout": "full-screen",
        "content_zone": "center on face",
        "default_transition": { "enter": "hard-cut", "exit": "fade", "enterDur": 0, "exitDur": 4 },
        "mandatory_extras": [],
        "notes": "Dark background (GradientMesh). OverlayKeyword shows the action word (FOLLOW, COMMENT, SAVE). ProgressRing optional."
      },
      "section_transition": {
        "primary": ["FlashReset"],
        "secondary": [],
        "avatar_layout": "hidden",
        "content_zone": "—",
        "default_transition": { "enter": "flash-reset", "exit": "hard-cut", "enterDur": 3, "exitDur": 0 },
        "mandatory_extras": [],
        "notes": "2-3 frame white flash only. Not a full beat — typically 6-9 frames total."
      },
      "reframe_montage": {
        "primary": ["FramedImage"],
        "secondary": [],
        "avatar_layout": "hidden",
        "content_zone": "full frame",
        "default_transition": { "enter": "hard-cut", "exit": "hard-cut", "enterDur": 0, "exitDur": 0 },
        "mandatory_extras": ["Multiple FramedImage entries in rapid sequence (3-5 frames each)"],
        "notes": "Use multiple sequential FramedImage entries — NOT one image. Each cut reinforces a different proof."
      },
      "tool_intro_chapter": {
        "primary": ["ChapterDivider"],
        "secondary": [],
        "avatar_layout": "hidden",
        "content_zone": "full frame",
        "default_transition": { "enter": "scale-pop-overshoot", "exit": "fade", "enterDur": 6, "exitDur": 3 },
        "mandatory_extras": ["Brand logo must be fetched via lib.assets before assembly"],
        "notes": "ChapterDivider uses the brand logo + tool name. Always fetch the SVG logo first."
      }
    },

    "cinematic-presenter": {
