        "mandatory_extras": [],
        "notes": "Avatar full-screen. NumberPopup floats above at top of frame."
      },
      "explanation_over_visual": {
        "primary": ["FramedImage"],
        "secondary": [],
        "avatar_layout": "split-screen",
        "content_zone": "top 40%",
