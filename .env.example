# Reel Generation Pipeline — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is loaded by Node scripts via dotenv.
# Python scripts read these via os.environ / os.getenv.

# ── Transcription (ingest-voice, Phase 2) ────────────────────────────────────
# Required for WhisperAPIProvider. Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── B-roll Classification (broll-pipeline, Phase 1b) ────────────────────────
# Required for Gemini Vision scene classification and embeddings.
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── X/Twitter Demo Capture (capture-demo Stage 0) ───────────────────────────
# Session cookies from x.com — grab from DevTools > Application > Cookies.
# These expire on logout or password change. Refresh when needed.
AUTH_TOKEN=
CT0=

# ── Optional ─────────────────────────────────────────────────────────────────
# Override Chrome user data directory for Playwright capture scripts.
# CHROME_USER_DATA=
