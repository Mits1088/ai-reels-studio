# Reel Generation Pipeline — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is loaded by Node scripts via dotenv.
# Python scripts read these via os.environ / os.getenv.

# ── Transcription (ingest-voice, Phase 2) ────────────────────────────────────
# Required for WhisperAPIProvider. Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── B-roll Classification (broll-pipeline, Phase 1b) ────────────────────────
# Required for Gemini Vision scene classification and embeddings.
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── X/Twitter Demo Capture (capture-demo Stage 0) ───────────────────────────
# Session cookies from x.com — grab from DevTools > Application > Cookies.
# These expire on logout or password change. Refresh when needed.
AUTH_TOKEN=
CT0=

# ── Asset Sourcing (lib.assets, Phase 4 capture-demo + Phase 1b broll) ─────
# Free stock video/image APIs. All have free tiers — no payment required.
# Each key is independently optional; lib.assets fails gracefully without them.

# Pexels — https://www.pexels.com/api/
# Free key, instant approval. 200 req/hr, 20k req/mo. No attribution required.
PEXELS_API_KEY=

# Pixabay — https://pixabay.com/api/docs/
# Free key after creating an account. 100 req/min. No attribution required.
PIXABAY_API_KEY=

# Coverr — https://coverr.co/developers
# Free key, 1000 calls/month. ATTRIBUTION REQUIRED on free tier — lib.assets
# tracks this in the project sourced catalog (run: python -m lib.assets attribution <slug>).
COVERR_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Override Chrome user data directory for Playwright capture scripts.
# CHROME_USER_DATA=
